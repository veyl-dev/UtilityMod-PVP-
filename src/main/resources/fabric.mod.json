{
  "schemaVersion": 1,
  "id": "utilitymod_pvp",
  "version": "${version}",
  "name": "UtilityMod-PVP",
  "description": "A lightweight client-side PvP utility HUD and toolkit.",
  "authors": ["veyl-dev"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.veyl.utilitymodpvp.UtilityModClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": ">=${fabric_api_min}"
  }
}
